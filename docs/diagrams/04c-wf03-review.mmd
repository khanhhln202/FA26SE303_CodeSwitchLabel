flowchart TD
  subgraph Reviewer
    R1([Start]) --> R2[Open blind recording from review task] --> R3{Decision}
    R3 -- Approve --> R4[Submit vote]
    R3 -- "Reject + reasons" --> R4
    R3 -- Reject audio only --> X1[recording rejected - script kept - requeue same speaker]
    R3 -- Discard pair --> X2[script deactivated]
  end
  subgraph System
    R4 --> V{2 matching votes?}
    V -- No --> W[Wait for next reviewer, max 3, distinct, not the speaker]
    V -- approve --> A[recording approved]
    V -- reject --> J[recording rejected]
    J --> C{Content-category reason?}
    C -- Yes --> P[script back to pending_validation]
    C -- No --> Q[script requeued for re-recording]
    A --> U[Update task progress]
    P --> U
    Q --> U
  end
  X1 --> U
  X2 --> U
  U --> E([End])
