  ROLE {
    smallint role_id PK
    string role_name UK
    text description
  }
  APP_USER {
    bigint user_id PK
    smallint role_id FK
    string full_name
    string email UK
    string phone
    string password_hash
    enum status
    timestamptz created_at
  }
  SPEAKER_PROFILE {
    bigint user_id PK
    smallint birth_year
    string province
    numeric english_level
    enum occupation
    string major
  }
  USER_DOMAIN {
    bigint user_id PK
    enum domain PK
    timestamptz assigned_at
  }
  SYSTEM_CONFIG {
    smallint config_id PK
    string config_key UK
    text config_value
    enum value_type
    text description
    bigint updated_by FK
    timestamptz updated_at
  }
  AUDIT_LOG {
    bigint audit_id PK
    timestamptz changed_at PK
    bigint user_id FK
    string entity_type
    string entity_id
    enum action
    jsonb old_value
    jsonb new_value
  }
  IMPORT_BATCH {
    bigint batch_id PK
    bigint imported_by FK
    text file_name
    int script_count
    timestamptz created_at
  }
  SCRIPT {
    string script_id PK
    text cs_content
    text vi_content
    enum status
    enum domain
    int word_count
    int en_word_count
    bigint created_by FK
    bigint import_batch_id FK
    timestamptz created_at
    timestamptz updated_at
  }
  SCRIPT_WORD {
    string script_id PK
    smallint word_position PK
    string en_word
    string vi_word
    enum relation
  }
  SCRIPT_ERROR_REASON {
    smallint reason_id PK
    string reason_code UK
    text description
    int sort_order
    bool is_active
  }
  SCRIPT_REVIEW {
    bigint script_review_id PK
    string script_id FK
    bigint user_id FK
    smallint error_reason_id FK
    enum action
    text edited_cs_content
    text edited_vi_content
    text comment
    timestamptz reviewed_at
  }
  SCRIPT_PROPOSAL {
    bigint proposal_id PK
    string script_id FK
    bigint proposer_id FK
    enum kind
    smallint error_reason_id FK
    text comment
    text proposed_cs_content
    text proposed_vi_content
    jsonb proposed_alignment
    enum status
    bigint decided_by FK
    timestamptz decided_at
    text decision_note
    timestamptz created_at
  }
  SCRIPT_QUEUE {
    bigint queue_id PK
    string script_id FK
    enum stage
    enum state
    timestamptz enqueued_at
    bigint claimed_by FK
    timestamptz claimed_at
    timestamptz claim_expires_at
    bigint task_id FK
  }
  CAMPAIGN {
    bigint campaign_id PK
    string campaign_name
    enum domain
    int target_qty
    date start_date
    date end_date
    enum status
    bigint created_by FK
    bigint assigned_to FK
    timestamptz created_at
  }
  CAMPAIGN_REGISTRATION {
    bigint campaign_id PK
    bigint speaker_id PK
    timestamptz registered_at
  }
  TASK {
    bigint task_id PK
    bigint campaign_id FK
    bigint created_by FK
    enum task_type
    enum domain
    text description
    int target_qty
    timestamptz deadline
    enum status
    timestamptz created_at
  }
  TASK_ASSIGNMENT {
    bigint assignment_id PK
    bigint task_id FK
    bigint user_id FK
    timestamptz assigned_at
    enum assignment_status
    int target_qty
  }
  TASK_SCRIPT {
    bigint task_id PK
    string script_id PK
    bigint assignee_user_id FK
    enum status
    timestamptz included_at
  }
  TASK_RECORDING {
    bigint task_id PK
    string recording_id PK
    enum status
    timestamptz included_at
  }
  RECORDING {
    string recording_id PK
    enum sentence_variant
    string script_id FK
    bigint speaker_id FK
    bigint task_id FK
    string cloud_link UK
    string audio_format
    enum status
    numeric duration_sec
    jsonb qc_metrics
    timestamptz discarded_at
    bigint discarded_by FK
    text discard_note
    timestamptz recorded_at
  }
  REJECTION_REASON {
    smallint reason_id PK
    string reason_code UK
    enum category
    text description
    bool is_active
  }
  REVIEW {
    bigint review_id PK
    string recording_id FK
    bigint reviewer_id FK
    bigint task_id FK
    smallint review_round
    enum decision
    bool is_blind
    text comment
    timestamptz reviewed_at
  }
  REVIEW_REJECTION_REASON {
    bigint review_id PK
    smallint reason_id PK
  }
  DATASET {
    bigint dataset_id PK
    string dataset_name
    string version
    text description
    jsonb filter_criteria
    enum status
    bigint released_by FK
    timestamptz released_at
    string file_key UK
    enum file_format
    int recording_count
    timestamptz created_at
  }
  DATASET_RECORDING {
    bigint dataset_id PK
    string recording_id PK
    timestamptz included_at
  }
