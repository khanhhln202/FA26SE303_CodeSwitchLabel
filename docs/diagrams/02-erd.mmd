  ROLE {
    smallint role_id PK
    string role_name UK
  }
  APP_USER {
    bigint user_id PK
    smallint role_id FK
    string email UK
    enum status
  }
  SPEAKER_PROFILE {
    bigint user_id PK
    smallint birth_year
    numeric english_level
    enum occupation
  }
  USER_DOMAIN {
    bigint user_id PK
    enum domain PK
  }
  SCRIPT {
    string script_id PK
    text cs_content
    text vi_content
    enum status
    enum domain
    int en_word_count
  }
  SCRIPT_WORD {
    string script_id PK
    smallint word_position PK
    string en_word
    string vi_word
    enum relation
  }
  SCRIPT_REVIEW {
    bigint script_review_id PK
    string script_id FK
    bigint user_id FK
    enum action
  }
  SCRIPT_PROPOSAL {
    bigint proposal_id PK
    string script_id FK
    enum kind
    enum status
  }
  SCRIPT_QUEUE {
    bigint queue_id PK
    string script_id FK
    enum stage
    enum state
    bigint claimed_by FK
    timestamptz enqueued_at
  }
  CAMPAIGN {
    bigint campaign_id PK
    enum domain
    int target_qty
    enum status
    bigint assigned_to FK
  }
  TASK {
    bigint task_id PK
    bigint campaign_id FK
    enum task_type
    int target_qty
    timestamptz deadline
    enum status
  }
  TASK_ASSIGNMENT {
    bigint assignment_id PK
    bigint task_id FK
    bigint user_id FK
    enum assignment_status
    int target_qty
  }
  RECORDING {
    string recording_id PK
    string script_id FK
    bigint speaker_id FK
    enum sentence_variant
    enum status
    numeric duration_sec
    jsonb qc_metrics
  }
  REVIEW {
    bigint review_id PK
    string recording_id FK
    bigint reviewer_id FK
    smallint review_round
    enum decision
  }
  REJECTION_REASON {
    smallint reason_id PK
    enum category
  }
  DATASET {
    bigint dataset_id PK
    string dataset_name
    string version
    enum status
  }
  SYSTEM_CONFIG {
    smallint config_id PK
    string config_key UK
  }
  AUDIT_LOG {
    bigint audit_id PK
    string entity_type
    enum action
  }
