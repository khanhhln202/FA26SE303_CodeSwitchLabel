stateDiagram-v2
  %% Source: RecordingService (upload + auto-QC), ReviewService (SubmitReviewAsync, RejectAudioAsync,
  %% DiscardPairAsync -> RecordingRepository.MarkAllRejectedAsync), trg_review_majority.
  %% discard-pair marks EVERY recording of the pair that is not already rejected as rejected,
  %% including approved and qc_failed siblings, and deactivates the script.
  [*] --> qc_failed: upload fails auto-QC
  [*] --> pending_review: upload passes auto-QC
  pending_review --> approved: majority of review rounds approve (2 of 3 by default)
  pending_review --> rejected: majority reject, reject-audio, or discard-pair
  approved --> rejected: discard-pair (all recordings of the pair)
  qc_failed --> rejected: discard-pair (all recordings of the pair)
  qc_failed --> [*]: speaker re-records (new take _tN)
  rejected --> [*]: script requeued, same speaker re-records (not after discard-pair)
  approved --> [*]: eligible for dataset
