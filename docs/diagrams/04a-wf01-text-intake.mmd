%% WF01 - Import -> batch text review -> validated
flowchart TD
  subgraph Admin
    A1([Start]) --> A2[Import JSON of script pairs]
  end
  A2 --> S1{Valid and not duplicate?}
  S1 -- No --> A3[Return per-item errors]
  S1 -- Yes --> Q1[(Trigger: script pending_validation + queue text_review)]
  subgraph TaskManager
    T1[Create text-review task, claim batch ~100]
  end
  Q1 --> T1
  subgraph Reviewer_or_Speaker
    R1[Open next claimed sentence] --> R2{Decision}
    R2 -- Accept --> R3[validated]
    R2 -- Edit pair --> R3
    R2 -- "Reject + reason" --> R4[rejected]
  end
  T1 --> R1
  R3 --> Q2[(Trigger: queue recording stage)]
  Q2 --> E1([End])
  R4 --> E1
