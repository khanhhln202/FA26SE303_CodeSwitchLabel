# Chép file này thành deploy/.env trên máy chủ rồi điền giá trị thật.
# KHÔNG commit file .env — .gitignore đã chặn sẵn.

# --- Tên miền (phải trỏ A record về IP máy chủ trước khi chạy) ---
API_DOMAIN=api.codeswitchlabel.example
FILES_DOMAIN=files.codeswitchlabel.example

# Chỉ có MỘT tên miền (ví dụ tên miền miễn phí Azure cấp kèm IP)? Đặt cả ba dòng sau,
# API và kho file dùng chung một tên, tách nhau bằng đường dẫn /recordings:
#   API_DOMAIN=<nhãn>.southeastasia.cloudapp.azure.com
#   FILES_DOMAIN=<đúng tên miền đó>
#   CADDYFILE=./Caddyfile.one-host
CADDYFILE=./Caddyfile

# --- Origin của frontend, để mở CORS. Lấy đúng domain Vercel, không có dấu / ở cuối ---
FE_ORIGIN=https://fa-26-se-303-code-switch-label-ebon.vercel.app
# Vercel sinh domain riêng cho mỗi bản preview; điền thêm một domain hay dùng nếu cần
FE_ORIGIN_PREVIEW=https://codeswitchlabel-git-main-nhom.vercel.app
# Máy cá nhân của đội frontend (Vite mặc định cổng 5173). Có dòng này thì họ trỏ
# VITE_API_BASE_URL vào máy chủ là chạy được, khỏi cần dựng backend trên máy mình.
# Bản chạy thật: bỏ trống dòng này.
FE_ORIGIN_LOCAL=http://localhost:5173

# --- Mật khẩu database. Sinh bằng: openssl rand -base64 24 ---
POSTGRES_PASSWORD=

# --- Tài khoản MinIO. User đặt tuỳ ý, mật khẩu ít nhất 12 ký tự ---
MINIO_ROOT_USER=csl_minio
MINIO_ROOT_PASSWORD=

# --- Khoá ký JWT, tối thiểu 32 ký tự. Sinh bằng: openssl rand -base64 48 ---
# Đổi khoá này là mọi token đang dùng hết hiệu lực, ai cũng phải đăng nhập lại.
JWT_KEY=
JWT_EXPIRY_MINUTES=120

# --- Máy chủ thử nghiệm cho đội frontend ---
# Bật Swagger để frontend tra API. Bản chạy thật sau này đặt false.
SWAGGER_ENABLED=true
# Mật khẩu chung cho các tài khoản mẫu (admin, manager, reviewer, speaker...).
# PHẢI khác mật khẩu dev, vì máy chủ này ai có link cũng vào được.
# Bỏ trống dòng này thì hệ thống không tạo dữ liệu mẫu nào.
SEED_PASSWORD=

# --- LLM gán nhãn khi nhập .txt (tuỳ chọn) ---
# Endpoint OpenAI-compatible; để trống LLM_ENDPOINT/LLM_MODEL thì backend gán nhãn bằng luật.
# LLM_API_KEY chỉ cần khi endpoint yêu cầu xác thực. KHÔNG commit giá trị thật.
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

# Endpoint OpenAI-compatible cho bước chuyển âm thanh thành chữ (máy duyệt bản ghi).
# Để trống ASR_ENDPOINT/ASR_MODEL thì endpoint máy duyệt trả `asr_not_configured`,
# API vẫn khởi động bình thường.
#
# ASR_LANGUAGE CỐ Ý để trống: khai "vi" sẽ ép mô hình nghe mọi thứ thành tiếng Việt và
# phiên âm từ tiếng Anh thành chữ Việt gần âm, làm tỉ lệ sai từ vọt lên oan cho người đọc.
# Câu trộn Việt-Anh cần để mô hình tự nhận.
#
# KHÔNG commit giá trị thật.
#
# --- Chọn đường nào: dịch vụ ngoài hay chạy tại chỗ ---
#
# ĐANG DÙNG: dịch vụ ngoài. Lý do không phải tiền (cả đồ án tốn ~$0.36) mà là TÀI NGUYÊN:
# máy chủ chỉ có 2 nhân và 3,8 GB RAM, đang gánh API, database và kho file. Một lượt nhận
# dạng tại chỗ mất 45–60 giây và chiếm trọn CPU suốt thời gian đó, làm cả hệ thống ì theo.
# Gọi ra ngoài thì ~2 giây và không tốn chút tài nguyên nào của máy chủ.
#
#   ASR_ENDPOINT=https://openrouter.ai/api/v1
#   ASR_MODEL=openai/whisper-large-v3
#   ASR_API_KEY=<khoá OpenRouter, cần số dư tối thiểu $0.50 mới mở endpoint âm thanh>
#
# Groq và OpenAI KHÔNG dùng được: máy chủ đặt ở vùng Azure East Asia (Hồng Kông) và cả hai
# chặn theo quốc gia — gọi không kèm khoá cũng ra 403 chứ không phải 401, tức chặn trước cả
# khâu kiểm khoá.
#
# --- Đường lui: dịch vụ nhận dạng chạy ngay trên máy này ---
#
# Service `asr` trong docker-compose vẫn chạy sẵn, dùng khi nhà cung cấp trục trặc hoặc hết
# số dư. Trỏ về bằng hai dòng dưới, ASR_API_KEY để trống vì dịch vụ nội bộ không đòi xác thực:
#
#   ASR_ENDPOINT=http://asr:8000/v1
#   ASR_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
#   ASR_API_KEY=

# --- Giới hạn tài nguyên của service asr ---
#
# ASR_MEM_LIMIT dùng cho CẢ mem_limit lẫn memswap_limit, tức container KHÔNG được dùng swap.
# Đừng nới memswap_limit để "cho thoáng": đã thử rồi và phải trả giá. Cho mượn swap thì model
# bị đẩy xuống đĩa lúc rảnh, rồi chạm trần lúc nạp ngược trở lại và bị giết giữa chừng — một
# lượt duyệt kéo dài hàng chục phút mà không có dấu hiệu gì chỉ ra nguyên nhân.
#
# Trần phải đủ rộng cho ĐỈNH lúc nạp model (đo được ~1,6 GB), không phải cho lúc chạy ổn
# định (~0,8 GB): model trên đĩa là float16, CTranslate2 đọc trọn vào RAM rồi mới nén xuống int8.
ASR_MEM_LIMIT=2048m

# Máy chủ chỉ có 2 nhân. Không chặn thì một lượt nhận dạng chiếm trọn cả hai và bỏ đói API
# lẫn database. Chừa 0,5 nhân cho phần còn lại.
ASR_CPUS=1.5

# --- Giá trị đang dùng ---
#
# ASR_TIMEOUT_SECONDS=180 chứ không phải 120: con số này phải đủ rộng cho đường lui tại chỗ,
# nơi lần gọi đầu sau một quãng nghỉ còn phải chờ nạp lại model (~60 giây) rồi mới phiên âm.
# Gọi ra ngoài thì chỉ mất vài giây, nhưng để rộng không hại gì.
# Model CỐ Ý chọn trùng với bản đang tự host, không phải vì rẻ: đó chính là model cho ra
# WER 0.000 trên r_cs_211000002 khi đo tại chỗ. Trùng model nên kết quả đã đo vẫn còn giá
# trị, và lùi đường không làm đổi phán quyết.
ASR_ENDPOINT=https://openrouter.ai/api/v1
ASR_MODEL=openai/whisper-large-v3-turbo
ASR_API_KEY=
ASR_LANGUAGE=
ASR_TIMEOUT_SECONDS=180

# --- Đường lui: dịch vụ chạy ngay trên máy chủ ---
#
# Gọi đường chính hỏng (mạng, 5xx, hết số dư, chặn tần suất) thì tự chuyển sang đây. Người
# duyệt chỉ thấy lượt đó chậm hơn chứ không thấy lỗi, và bản ghi không bị kẹt ở thế hoà.
#
# Bỏ trống ASR_FALLBACK_ENDPOINT là tắt hẳn cơ chế này.
#
# KHÔNG lùi khi lỗi là asr_empty_audio: file rỗng là lỗi dữ liệu của chính ta, đường lui
# cũng chịu y như vậy nên lùi chỉ tốn thêm gần một phút để nhận lại đúng câu trả lời đó.
ASR_FALLBACK_ENDPOINT=http://asr:8000/v1
ASR_FALLBACK_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
ASR_FALLBACK_API_KEY=
ASR_FALLBACK_LANGUAGE=
ASR_FALLBACK_TIMEOUT_SECONDS=180

# Chỉ có tác dụng với đường lui tại chỗ: bao lâu không dùng thì nhả model khỏi RAM, tính
# bằng giây. Để -1 là giữ mãi — lần gọi nào cũng nhanh, đổi lại mất đứt ~0,8 GB RAM kể cả
# khi không ai duyệt gì, trên một máy chủ chỉ có 3,8 GB.
ASR_MODEL_TTL=300
