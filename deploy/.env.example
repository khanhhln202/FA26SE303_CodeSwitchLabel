# Chép file này thành deploy/.env trên máy chủ rồi điền giá trị thật.
# KHÔNG commit file .env — .gitignore đã chặn sẵn.

# --- Tên miền (phải trỏ A record về IP máy chủ trước khi chạy) ---
API_DOMAIN=api.codeswitchlabel.example
FILES_DOMAIN=files.codeswitchlabel.example

# Chỉ có MỘT tên miền (ví dụ tên miền miễn phí Azure cấp kèm IP)? Đặt cả ba dòng sau,
# API và kho file dùng chung một tên, tách nhau bằng đường dẫn /recordings:
#   API_DOMAIN=<nhãn>.southeastasia.cloudapp.azure.com
#   FILES_DOMAIN=<đúng tên miền đó>
#   CADDYFILE=./Caddyfile.one-host
CADDYFILE=./Caddyfile

# --- Origin của frontend, để mở CORS. Lấy đúng domain Vercel, không có dấu / ở cuối ---
FE_ORIGIN=https://fa-26-se-303-code-switch-label-ebon.vercel.app
# Vercel sinh domain riêng cho mỗi bản preview; điền thêm một domain hay dùng nếu cần
FE_ORIGIN_PREVIEW=https://codeswitchlabel-git-main-nhom.vercel.app
# Máy cá nhân của đội frontend (Vite mặc định cổng 5173). Có dòng này thì họ trỏ
# VITE_API_BASE_URL vào máy chủ là chạy được, khỏi cần dựng backend trên máy mình.
# Bản chạy thật: bỏ trống dòng này.
FE_ORIGIN_LOCAL=http://localhost:5173

# --- Mật khẩu database. Sinh bằng: openssl rand -base64 24 ---
POSTGRES_PASSWORD=

# --- Tài khoản MinIO. User đặt tuỳ ý, mật khẩu ít nhất 12 ký tự ---
MINIO_ROOT_USER=csl_minio
MINIO_ROOT_PASSWORD=

# --- Khoá ký JWT, tối thiểu 32 ký tự. Sinh bằng: openssl rand -base64 48 ---
# Đổi khoá này là mọi token đang dùng hết hiệu lực, ai cũng phải đăng nhập lại.
JWT_KEY=
JWT_EXPIRY_MINUTES=120

# --- Máy chủ thử nghiệm cho đội frontend ---
# Bật Swagger để frontend tra API. Bản chạy thật sau này đặt false.
SWAGGER_ENABLED=true
# Mật khẩu chung cho các tài khoản mẫu (admin, manager, reviewer, speaker...).
# PHẢI khác mật khẩu dev, vì máy chủ này ai có link cũng vào được.
# Bỏ trống dòng này thì hệ thống không tạo dữ liệu mẫu nào.
SEED_PASSWORD=

# --- LLM gán nhãn khi nhập .txt (tuỳ chọn) ---
# Endpoint OpenAI-compatible; để trống LLM_ENDPOINT/LLM_MODEL thì backend gán nhãn bằng luật.
# LLM_API_KEY chỉ cần khi endpoint yêu cầu xác thực. KHÔNG commit giá trị thật.
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

# Endpoint OpenAI-compatible cho bước chuyển âm thanh thành chữ (máy duyệt bản ghi).
# Để trống ASR_ENDPOINT/ASR_MODEL thì endpoint máy duyệt trả `asr_not_configured`,
# API vẫn khởi động bình thường.
#
# ASR_LANGUAGE CỐ Ý để trống: khai "vi" sẽ ép mô hình nghe mọi thứ thành tiếng Việt và
# phiên âm từ tiếng Anh thành chữ Việt gần âm, làm tỉ lệ sai từ vọt lên oan cho người đọc.
# Câu trộn Việt-Anh cần để mô hình tự nhận.
#
# KHÔNG commit giá trị thật.
#
# --- Dùng dịch vụ nhận dạng chạy ngay trên máy này (mặc định) ---
# Service `asr` trong docker-compose đã lo phần máy chủ. Hai dòng dưới trỏ API vào nó;
# ASR_API_KEY để trống vì dịch vụ nội bộ không đòi xác thực.
#
# ASR_TIMEOUT_SECONDS=180 chứ không phải 120: model được nhả khỏi RAM sau ASR_MODEL_TTL
# giây không dùng, nên lần gọi đầu sau một quãng nghỉ phải chờ nạp lại (đo thật: ~60 giây)
# rồi mới phiên âm (~22 giây). Để 120 là lần gọi đầu tiên trong ngày sẽ hết giờ oan.
ASR_ENDPOINT=http://asr:8000/v1
ASR_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
ASR_API_KEY=
ASR_LANGUAGE=
ASR_TIMEOUT_SECONDS=180

# Bao lâu không dùng thì nhả model khỏi RAM, tính bằng giây. Để -1 là giữ mãi:
# lần gọi nào cũng nhanh, đổi lại mất đứt 1 GB RAM kể cả khi không ai duyệt gì.
ASR_MODEL_TTL=300

# --- Nếu sau này muốn quay lại dùng dịch vụ bên ngoài ---
# Máy chủ đặt ở vùng Azure East Asia (Hồng Kông). Groq và OpenAI CHẶN theo quốc gia:
# gọi không kèm khoá cũng ra 403 chứ không phải 401, tức chặn trước cả khâu kiểm khoá.
# OpenRouter gọi được nhưng đòi số dư tối thiểu $0.50 mới mở endpoint âm thanh:
#   ASR_ENDPOINT=https://openrouter.ai/api/v1
#   ASR_MODEL=openai/whisper-large-v3
#   ASR_API_KEY=<khoá OpenRouter>
