{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "_comment": "Giá trị thật của ConnectionStrings:Postgres, Jwt:Key, ObjectStorage:AccessKey, ObjectStorage:SecretKey và Seed:DefaultPassword KHÔNG bao giờ đặt ở file này. Lúc dev dùng appsettings.Development.json hoặc user-secrets; lúc chạy thật dùng biến môi trường, ví dụ ObjectStorage__SecretKey.",

  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "codeswitchlabel-api",
    "Audience": "codeswitchlabel-web",
    "Key": "",
    "ExpiryMinutes": 120
  },
  "ObjectStorage": {
    "ServiceUrl": "",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "recordings",
    "Region": "us-east-1",
    "ForcePathStyle": true,
    "PresignedUrlMinutes": 15
  },
  "Audio": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "TargetSampleRate": 16000,
    "TargetChannels": 1,
    "ProcessTimeoutSeconds": 60,
    "MaxUploadMegabytes": 20
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
