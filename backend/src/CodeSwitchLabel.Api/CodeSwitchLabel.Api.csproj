<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Sinh file XML để Swagger đọc được chú thích /// trong controller.
         CS1591 cảnh báo "thiếu chú thích trên thành viên công khai" — tắt đi vì
         chỉ endpoint mới cần mô tả, DTO thì tên đã tự nói lên ý nghĩa. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeSwitchLabel.Services\CodeSwitchLabel.Services.csproj" />
  </ItemGroup>

</Project>
