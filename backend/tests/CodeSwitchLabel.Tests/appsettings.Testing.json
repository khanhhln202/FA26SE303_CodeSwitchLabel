{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "codeswitchlabel-api",
    "Audience": "codeswitchlabel-web",
    "Key": "test-signing-key-32-bytes-minimum-length!!",
    "ExpiryMinutes": 60
  },
  "ObjectStorage": {
    "ServiceUrl": "http://localhost:9000",
    "AccessKey": "test",
    "SecretKey": "test",
    "BucketName": "recordings",
    "Region": "us-east-1",
    "ForcePathStyle": true,
    "PresignedUrlMinutes": 15
  },
  "Audio": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "TargetSampleRate": 16000,
    "TargetChannels": 1,
    "ProcessTimeoutSeconds": 60,
    "MaxUploadMegabytes": 20
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "Seed": {
    "DefaultPassword": "Test@123456"
  }
}