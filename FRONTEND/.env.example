# Địa chỉ backend CodeSwitchLabel (không có dấu / ở cuối).
# Chép file này thành .env.local rồi sửa giá trị - .env.local không bị commit.
#   Backend chạy trên máy: http://localhost:5053
#   Máy chủ thử nghiệm của nhóm: dán URL Swagger (bỏ phần /index.html)
VITE_API_BASE_URL=http://localhost:5053

# Google Client ID dùng cho nút "Tiếp tục với Google" - phải trùng GoogleAuth:ClientId của backend.
# Trong Google Cloud Console nhớ thêm http://localhost:5173 vào Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=
